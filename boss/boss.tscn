[sub_resource type="GDScript" id="GDScript_7ke2s"]
script/source = "extends CharacterBody2D

signal bosshealth_changed(value)
signal sethealthbar(max_health)
signal setname(name)

@export_group(\"Movement\")
@export var top_speed = 150
@export var acceleration = 800
@export var friction = 600

@export_group(\"Sun\")
@export var boss_name := \"Sun\"
@export var max_health := 10

var health = 0
var player = null

func _ready():
	$AnimatedSprite2D.play(\"run\")
	player = get_tree().get_first_node_in_group(\"player\")

	health = max_health

	# Send initial values to UI
	sethealthbar.emit(max_health)
	bosshealth_changed.emit(health)
	setname.emit(boss_name)

func take_damage(amount, source_pos):
	health -= amount

	flash_sprite()
	punchy_scale()
	# Update UI
	bosshealth_changed.emit(health)

	if health <= 0:
		die()

func flash_sprite():
	var tween = create_tween()

	$AnimatedSprite2D.modulate = Color.WHITE * 5

	tween.tween_property($AnimatedSprite2D,\"modulate\",Color.WHITE,0.2)

func die():
	$CollisionPolygon2D.set_deferred(\"disabled\", true)
	set_physics_process(false)
	$AnimatedSprite2D.play(\"hit\")
	velocity = Vector2.ZERO
	await $AnimatedSprite2D.animation_finished

	queue_free()

func _on_hitbox_entered(area: Area2D):
	if area.is_in_group(\"swing\"):
		take_damage(area.damage, area.player_pos_at_hit)

func punchy_scale():
	var tween = create_tween()
	$AnimatedSprite2D.scale = Vector2(0.7, 1.3)
	tween.tween_property($AnimatedSprite2D,\"scale\",Vector2(1, 1),0.3).set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_OUT)
	
	
"

