[sub_resource type="GDScript" id="GDScript_7ke2s"]
script/source = "extends CharacterBody2D

signal bosshealth_changed(value)
signal sethealthbar(max_health)
signal setname(name)

@export var lunge_attack_scene: PackedScene
@export var ranged_attack_scene: PackedScene

@export_group(\"Movement\")
@export var lunge_speed = 700  
@export var top_speed = 100
@export var acceleration = 800
@export var friction = 600

@export_group(\"Death\")
@export var boss_name := \"Death\"
@export var max_health := 10
@export var projectile_speed = 500

var health = 0
var player = null
var attacking = false

func _ready():
	$AnimatedSprite2D.play(\"run\")
	player = get_tree().get_first_node_in_group(\"player\")

	health = max_health

	sethealthbar.emit(max_health)
	bosshealth_changed.emit(health)
	setname.emit(boss_name)
	
	var timer = Timer.new()
	add_child(timer)
	timer.wait_time = 3.0
	timer.timeout.connect(choose_attack)
	timer.start()
	

func _physics_process(delta: float) -> void:
	if player == null: return
	if not attacking: 
		var dir = (player.global_position - global_position).normalized()
		velocity = velocity.move_toward(dir * top_speed, acceleration * delta)
		$AnimatedSprite2D.flip_h = dir.x < 0  
		$AnimatedSprite2D.play(\"run\")
	else:
		velocity = velocity.move_toward(Vector2.ZERO, friction * delta)
	move_and_slide()

func take_damage(amount, source_pos):
	health -= amount

	flash_sprite()
	punchy_scale()
	# Update UI
	bosshealth_changed.emit(health)

	if health <= 0:
		die()

func flash_sprite():
	var tween = create_tween()

	$AnimatedSprite2D.modulate = Color.WHITE * 5

	tween.tween_property($AnimatedSprite2D,\"modulate\",Color.WHITE,0.2)

func die():
	$CollisionPolygon2D.set_deferred(\"disabled\", true)
	set_physics_process(false)
	$AnimatedSprite2D.play(\"hit\")
	velocity = Vector2.ZERO
	await $AnimatedSprite2D.animation_finished

	queue_free()

func _on_hitbox_entered(area: Area2D):
	if area.is_in_group(\"swing\") or area.is_in_group(\"player_proj\"):
		take_damage(area.damage, area.player_pos_at_hit)

func punchy_scale():
	var tween = create_tween()
	$AnimatedSprite2D.scale = Vector2(0.7, 1.3)
	tween.tween_property($AnimatedSprite2D,\"scale\",Vector2(1, 1),0.3).set_trans(Tween.TRANS_ELASTIC).set_ease(Tween.EASE_OUT)



func lunge_attack():
	if player == null:return
	if lunge_attack_scene == null:return
	
	var direction = (player.global_position - global_position).normalized()
	velocity = direction * lunge_speed
	$AnimatedSprite2D.flip_h = direction.x < 0
	
	var swing = lunge_attack_scene.instantiate()
	var offset = 67
	if swing.has_method(\"set_player_info\"):
		swing.set_player_info(velocity, global_position)
	add_child(swing)
	swing.global_position = global_position
	swing.rotation = direction.angle() + deg_to_rad(-90)
	swing.global_position += direction * offset
	
	attacking = true
	$AnimatedSprite2D.play(\"stab\")
	await $AnimatedSprite2D.animation_finished
	attacking = false

func ranged_attack():
	if player == null:return
	if ranged_attack_scene == null:return
	
	var direction = (player.global_position - global_position).normalized()
	$AnimatedSprite2D.flip_h = direction.x < 0
	
	var projectile = ranged_attack_scene.instantiate()
	var offset = 67
	get_parent().add_child(projectile)
	projectile.global_position = global_position + direction * offset
	projectile.rotation = direction.angle() + deg_to_rad(-90)
	projectile.velocity = direction * projectile_speed  
	
	attacking = true
	$AnimatedSprite2D.play(\"stab\")
	await  $AnimatedSprite2D.animation_finished
	attacking = false

func slash_attack():
	if player == null: return
	if lunge_attack_scene == null: return
	
	var direction = (player.global_position - global_position).normalized()
	$AnimatedSprite2D.flip_h = direction.x < 0
	
	var swing = lunge_attack_scene.instantiate()
	var offset = 67
	if swing.has_method(\"set_player_info\"):
		swing.set_player_info(velocity, global_position)
	add_child(swing)
	swing.global_position = global_position
	swing.rotation = direction.angle() + deg_to_rad(-90)
	swing.global_position += direction * offset
	
	attacking = true
	$AnimatedSprite2D.play(\"stab\")
	await $AnimatedSprite2D.animation_finished
	attacking = false

func choose_attack():
	if player == null: return
	var distance = global_position.distance_to(player.global_position)
	if distance > 1000:return
	if distance > 400:
		ranged_attack()
	elif distance > 200:
		lunge_attack()
	else:
		slash_attack()
"

